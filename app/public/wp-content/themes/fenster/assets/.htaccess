# SEO plan 10/11/2026, 5.7: theme files were served with no Cache-Control or
# Expires at all, so repeat visits revalidated every font, image and stylesheet.
#
# Fonts never change under the same name: a year. Stylesheets and scripts are
# enqueued with a version from the file's own size and time (inc/assets.php), so
# a change is a new URL; a week covers anything fetched without one. Images are
# sometimes re-encoded in place under the same name, so they get 30 days rather
# than a year.
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|woff|otf|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
