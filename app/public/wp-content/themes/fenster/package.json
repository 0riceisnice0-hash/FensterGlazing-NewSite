{
  "name": "fenster-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Hardcoded AI-maintained WordPress theme for Fenster Glazing.",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass src/scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "build:js": "esbuild src/js/main.js --bundle --minify --outfile=assets/js/main.js",
    "encode:product-videos": "node scripts/encode-product-scroll-videos.cjs",
    "build:atrium": "npm run build:atrium:css && npm run build:atrium:js",
    "build:atrium:css": "sass src/experimental/atrium.scss assets/experimental/atrium.css --style=compressed --no-source-map",
    "build:atrium:js": "esbuild src/experimental/atrium.js --bundle --format=esm --target=es2020 --minify --outfile=assets/experimental/atrium.js",
    "watch:atrium": "npm-run-all --parallel watch:atrium:css watch:atrium:js",
    "watch:atrium:css": "sass src/experimental/atrium.scss assets/experimental/atrium.css --style=expanded --watch",
    "watch:atrium:js": "esbuild src/experimental/atrium.js --bundle --format=esm --target=es2020 --sourcemap --outfile=assets/experimental/atrium.js --watch",
    "trace:logo": "node scripts/trace-logo.mjs assets/brand/favicon-512.png assets/experimental/fenster-mark.svg",
    "watch": "npm-run-all --parallel watch:css watch:js",
    "watch:css": "sass src/scss/main.scss assets/css/main.css --style=expanded --watch",
    "watch:js": "esbuild src/js/main.js --bundle --sourcemap --outfile=assets/js/main.js --watch",
    "sweep": "node scripts/sweep.mjs",
    "models:optimise": "node scripts/optimise-models.mjs",
    "models:verify": "esbuild src/showroom/verify.js --bundle --format=esm --target=es2020 --outfile=assets/showroom/_verify.js && node scripts/shot.mjs \"http://fenster-glazing.local/wp-content/themes/fenster/assets/showroom/_verify.html\" --w 900 --h 600 --tag VERIFY --wait 4000 --settle 300 --eval \"window.__verify()\"",
    "build:showroom": "npm run build:showroom:css && npm run build:showroom:js",
    "build:showroom:css": "sass src/showroom/showroom.scss assets/showroom/showroom.css --style=compressed --no-source-map",
    "build:showroom:js": "esbuild src/showroom/showroom.js --bundle --format=esm --target=es2020 --minify --outfile=assets/showroom/showroom.js",
    "posters": "esbuild src/showroom/posters.js --bundle --format=esm --target=es2020 --outfile=assets/showroom/_posters.js && node scripts/render-posters.mjs",
    "cards": "node scripts/render-card-thumbs.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "draco3dgltf": "^1.5.7",
    "esbuild": "^0.25.5",
    "ffmpeg-static": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.2.0",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "sass": "^1.89.1"
  },
  "dependencies": {
    "lenis": "^1.3.23",
    "three": "0.169.0"
  }
}
